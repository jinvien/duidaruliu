{
  "name": "@ddrl/chrome",
  "description": "Sidepanel-first and local-only chat extension for ollama",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "pnpm --filter @ddrl/chat test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ddrl/chat": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "^1.1.2",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "tsx": "4.20.6",
    "typescript": "^5.6.3",
    "wxt": "^0.19.13"
  }
}
